{
  "permissions": {
    "allow": [
      "Bash(docker --version)",
      "Bash(docker compose *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:8080/)",
      "Bash(curl -s http://localhost:8080/)",
      "Bash(curl -s http://localhost:8080/health)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:8080/ready)",
      "Bash(curl -s -w \"\\\\nHTTP %{http_code}\\\\n\" http://localhost:8080/)",
      "Bash(curl -s -w \"\\\\nHTTP %{http_code}\\\\n\" http://localhost:8080/health)",
      "Bash(curl -s -w \"\\\\nHTTP %{http_code}\\\\n\" http://localhost:8080/ready)",
      "Bash(curl -s -w \"\\\\nHTTP %{http_code}\\\\n\" -X POST http://localhost:8080/api/auth/register -H \"Content-Type: application/json\" -d '{\"email\":\"admin@campus.fr\",\"password\":\"adminpass123\",\"first_name\":\"Ada\",\"last_name\":\"Lovelace\",\"role\":\"admin\"}')",
      "Bash(curl -s -X POST http://localhost:8080/api/auth/login -H \"Content-Type: application/json\" -d '{\"email\":\"admin@campus.fr\",\"password\":\"adminpass123\"}')"
    ]
  }
}
