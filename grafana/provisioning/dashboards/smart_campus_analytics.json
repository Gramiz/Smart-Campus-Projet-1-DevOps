      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "smartcampus_mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH hours AS (\n  SELECT 0 AS h UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3\n  UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7\n  UNION ALL SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10 UNION ALL SELECT 11\n  UNION ALL SELECT 12 UNION ALL SELECT 13 UNION ALL SELECT 14 UNION ALL SELECT 15\n  UNION ALL SELECT 16 UNION ALL SELECT 17 UNION ALL SELECT 18 UNION ALL SELECT 19\n  UNION ALL SELECT 20 UNION ALL SELECT 21 UNION ALL SELECT 22 UNION ALL SELECT 23\n),\nagg AS (\n  SELECT HOUR(start_time) AS h, COUNT(*) AS c\n  FROM bookings\n  WHERE status <> 'cancelled' AND start_time >= NOW() - INTERVAL 14 DAY\n  GROUP BY HOUR(start_time)\n)\nSELECT CONCAT(LPAD(hours.h, 2, '0'), 'h') AS hour, ROUND(COALESCE(agg.c, 0) / 14.0, 2) AS predicted_bookings\nFROM hours\nLEFT JOIN agg ON agg.h = hours.h\nORDER BY hours.h;",
          "refId": "A"
        }
      ],
      "title": "Prévision réservations next-day par heure (moy. 14j)",
