      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "smartcampus_mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  b.id AS booking_id,\n  r.room_number AS room,\n  b.start_time,\n  b.end_time,\n  ROUND(AVG(sd.value) * 100, 1) AS avg_occ_pct\nFROM bookings b\nJOIN rooms r ON r.id = b.room_id\nJOIN sensors s ON s.room_id = r.id AND s.sensor_type = 'occupancy'\nJOIN sensor_data sd ON sd.sensor_id = s.id AND sd.timestamp BETWEEN b.start_time AND b.end_time\nWHERE b.status <> 'cancelled' AND $__timeFilter(b.start_time)\nGROUP BY b.id, r.room_number, b.start_time, b.end_time\nHAVING AVG(sd.value) < 0.2\nORDER BY b.start_time DESC\nLIMIT 50;",
          "refId": "A"
        }
      ],
      "title": "Ghost rooms — réservées mais vides",
      "type": "table"
    },
    {
      "datasource": { "type": "mysql", "uid": "smartcampus_mysql" },
      "description": "Mesures capteur dont le z-score (écart à la moyenne en σ) dépasse 3 — valeurs aberrantes statistiques.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "z_score" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "yellow", "value": null },
                    { "color": "orange", "value": 3 },
                    { "color": "red", "value": 5 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "smartcampus_mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH stats AS (\n  SELECT\n    sd.sensor_id,\n    sd.value,\n    sd.timestamp,\n    s.sensor_type,\n    s.room_id,\n    AVG(sd.value)        OVER (PARTITION BY sd.sensor_id) AS mu,\n    STDDEV_POP(sd.value) OVER (PARTITION BY sd.sensor_id) AS sigma\n  FROM sensor_data sd\n  JOIN sensors s ON s.id = sd.sensor_id\n  WHERE $__timeFilter(sd.timestamp)\n)\nSELECT\n  sensor_id,\n  sensor_type,\n  room_id,\n  ROUND(value, 3) AS value,\n  timestamp,\n  ROUND(ABS((value - mu) / NULLIF(sigma, 0)), 2) AS z_score\nFROM stats\nWHERE sigma > 0 AND ABS((value - mu) / sigma) >= 3\nORDER BY z_score DESC\nLIMIT 50;",
          "refId": "A"
        }
      ],
      "title": "Anomalies capteurs (|z-score| ≥ 3)",
      "type": "table"
    },
