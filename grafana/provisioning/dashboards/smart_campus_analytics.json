          "rawSql": "SELECT r.room_number AS room, ROUND(AVG(sd.value) * 100, 1) AS avg_pct\nFROM rooms r\nJOIN sensors s ON s.room_id = r.id AND s.sensor_type = 'occupancy'\nJOIN sensor_data sd ON sd.sensor_id = s.id\nWHERE $__timeFilter(sd.timestamp)\nGROUP BY r.id, r.room_number\nORDER BY avg_pct DESC\nLIMIT 10;",
