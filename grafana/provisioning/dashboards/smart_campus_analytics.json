          "rawSql": "SELECT COUNT(*) AS ghost_bookings\nFROM (\n  SELECT b.id\n  FROM bookings b\n  JOIN sensors s ON s.room_id = b.room_id AND s.sensor_type = 'occupancy'\n  JOIN sensor_data sd ON sd.sensor_id = s.id AND sd.timestamp BETWEEN b.start_time AND b.end_time\n  WHERE b.status <> 'cancelled' AND $__timeFilter(b.start_time)\n  GROUP BY b.id\n  HAVING AVG(sd.value) < 0.2\n) t;",
